from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Switch

__id__ = "desktop_hello"
__name__ = "Desktop Hello"
__description__ = "Minimal portable plugin used to validate the Desktop runtime."
__author__ = "AyuGram Desktop Plugins"
__version__ = "0.2.0"
__min_version__ = "12.5.1"


class Plugin(BasePlugin):
    def on_plugin_load(self):
        self.log("loaded")

    def on_send_message_hook(self, account, params):
        if not self.get_setting("prefix_outgoing", False):
            return None
        params.message = "[Desktop plugin] " + params.message
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    def create_settings(self):
        return [
            Header(text="Desktop Hello"),
            Switch(
                key="prefix_outgoing",
                text="Prefix outgoing messages",
                default=False,
            ),
        ]
