from base_plugin import BasePlugin
from ui.settings import Header, Switch

__id__ = "desktop_hello"
__name__ = "Desktop Hello"
__description__ = "Minimal portable plugin used to validate the Desktop runtime."
__author__ = "AyuGram Desktop Plugins"
__version__ = "0.1.0"
__min_version__ = "12.5.1"


class Plugin(BasePlugin):
    def on_plugin_load(self):
        self.log("loaded")

    def create_settings(self):
        return [
            Header(text="Desktop Hello"),
            Switch(
                key="enabled",
                text="Enabled",
                default=True,
            ),
        ]
